    {
      "parameters": {
        "jsCode": "\nconst resultados = $input.all().map(item => item.json);\n\n// Total de serviços monitorados\nconst total = resultados.length;\n\n// Contagem por classificação\nconst contar = (classificacao) =>\n  resultados.filter(\n    item => item.classificacao === classificacao\n  ).length;\n\nconst sucessos = contar('SUCESSO');\nconst falhasDNS = contar('FALHA_DNS');\nconst falhasHTTP = contar('FALHA_HTTP');\n\n// Contagem por tipo de serviço\nconst totalHTTP = resultados.filter(\n  item => item.tipo === 'HTTP'\n).length;\n\nconst totalDNS = resultados.filter(\n  item => item.tipo === 'DNS'\n).length;\n\n// Disponibilidade percentual\nconst disponibilidade = total > 0\n  ? Number(((sucessos / total) * 100).toFixed(2))\n  : 0;\n\n// Detalhamento das falhas\nconst falhas = resultados\n  .filter(item => item.classificacao !== 'SUCESSO')\n  .map(item => ({\n    nome: item.nome,\n    tipo: item.tipo,\n    alvo: item.alvo,\n    status_code: item.status_code ?? null,\n    erro: item.erro ?? null,\n    classificacao: item.classificacao\n  }));\n\n// Montagem do relatório\nconst relatorio = {\n  data_execucao: new Date().toISOString(),\n  total_monitorado: total,\n  total_http: totalHTTP,\n  total_dns: totalDNS,\n  sucessos: sucessos,\n  falhas_dns: falhasDNS,\n  falhas_http: falhasHTTP,\n  disponibilidade_percentual: disponibilidade\n};\n\n// Retorno consolidado\nreturn [\n  {\n    json: {\n      relatorio,\n      falhas,\n      servicos: resultados\n    }\n  }\n];\n"
      },
