      ],
      "id": "5fc2013c-929e-4507-b72d-aec70eaa4f77",
      "name": "Merge - Resultados Geral"
    },
    {
      "parameters": {
        "jsCode": "\nconst dados = $input.first().json;\n\nconst relatorio = dados.relatorio;\nconst servicos = dados.servicos;\nconst falhas = dados.falhas;\n\nconst escapar = (valor) => String(valor ?? '-')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#039;');\n\nconst dataFormatada = new Date(\n  relatorio.data_execucao\n).toLocaleString('pt-BR', {\n  timeZone: 'America/Sao_Paulo'\n});\n\nconst corClassificacao = (classificacao) => {\n  if (classificacao === 'SUCESSO') return '#15803d';\n  if (classificacao === 'FALHA_DNS') return '#dc2626';\n  if (classificacao === 'FALHA_HTTP') return '#d97706';\n  return '#64748b';\n};\n\nconst linhasServicos = servicos.map(servico => `\n  <tr>\n    <td>${escapar(servico.nome)}</td>\n    <td>${escapar(servico.tipo)}</td>\n    <td>${escapar(servico.alvo)}</td>\n    <td>${escapar(servico.status_code)}</td>\n    <td>\n      <span style=\"color:${corClassificacao(servico.classificacao)};font-weight:bold\">\n        ${escapar(servico.classificacao)}\n      </span>\n    </td>\n    <td>${escapar(servico.ip_resolvido)}</td>\n    <td>${escapar(servico.ttl)}</td>\n  </tr>\n`).join('');\n\nconst linhasFalhas = falhas.length\n  ? falhas.map(falha => `\n    <tr>\n      <td>${escapar(falha.nome)}</td>\n      <td>${escapar(falha.tipo)}</td>\n      <td>${escapar(falha.alvo)}</td>\n      <td>${escapar(falha.erro)}</td>\n      <td>${escapar(falha.classificacao)}</td>\n    </tr>\n  `).join('')\n  : '<tr><td colspan=\"5\">Nenhuma falha encontrada.</td></tr>';\n\nconst html = `<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Network Monitor - Relatório</title>\n\n<style>\n* { box-sizing: border-box; }\n\nbody {\n  font-family: Arial, sans-serif;\n  background: #f1f5f9;\n  color: #1e293b;\n  margin: 0;\n  padding: 30px;\n}\n\n.container {\n  max-width: 1200px;\n  margin: auto;\n  background: white;\n  padding: 30px;\n  border-radius: 12px;\n}\n\nheader {\n  border-bottom: 3px solid #2563eb;\n  padding-bottom: 20px;\n  margin-bottom: 25px;\n}\n\nh1 { color: #1e40af; margin-bottom: 5px; }\n\n.subtitulo { color: #64748b; }\n\n.indicadores {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n  gap: 15px;\n  margin: 25px 0;\n}\n\n.card {\n  padding: 20px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n}\n\n.card h3 {\n  margin: 0;\n  font-size: 14px;\n  color: #64748b;\n}\n\n.valor {\n  font-size: 28px;\n  font-weight: bold;\n  margin-top: 12px;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  margin: 15px 0 30px;\n  font-size: 13px;\n}\n\nth, td {\n  padding: 12px;\n  text-align: left;\n  border-bottom: 1px solid #e2e8f0;\n  overflow-wrap: anywhere;\n}\n\nth {\n  background: #1e40af;\n  color: white;\n}\n\nh2 {\n  color: #1e40af;\n  margin-top: 35px;\n}\n\nfooter {\n  border-top: 1px solid #e2e8f0;\n  padding-top: 15px;\n  color: #64748b;\n  font-size: 12px;\n}\n\n@media (max-width: 700px) {\n  body { padding: 10px; }\n  .container { padding: 15px; }\n  table { font-size: 11px; }\n}\n</style>\n</head>\n\n<body>\n<div class=\"container\">\n\n<header>\n  <h1>NETWORK MONITOR</h1>\n  <div class=\"subtitulo\">Relatório de monitoramento de serviços</div>\n  <p>Data da execução: ${escapar(dataFormatada)}</p>\n</header>\n\n<h2>Resumo executivo</h2>\n\n<div class=\"indicadores\">\n  <div class=\"card\">\n    <h3>Disponibilidade</h3>\n    <div class=\"valor\">${escapar(relatorio.disponibilidade_percentual)}%</div>\n  </div>\n\n  <div class=\"card\">\n    <h3>Total monitorado</h3>\n    <div class=\"valor\">${escapar(relatorio.total_monitorado)}</div>\n  </div>\n\n  <div class=\"card\">\n    <h3>Sucessos</h3>\n    <div class=\"valor\" style=\"color:#15803d\">\n      ${escapar(relatorio.sucessos)}\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h3>Falhas DNS</h3>\n    <div class=\"valor\" style=\"color:#dc2626\">\n      ${escapar(relatorio.falhas_dns)}\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h3>Falhas HTTP</h3>\n    <div class=\"valor\" style=\"color:#d97706\">\n      ${escapar(relatorio.falhas_http)}\n    </div>\n  </div>\n</div>\n\n<h2>Distribuição dos serviços</h2>\n<p>HTTP: ${escapar(relatorio.total_http)} |\nDNS: ${escapar(relatorio.total_dns)}</p>\n\n<h2>Serviços monitorados</h2>\n\n<table>\n<thead>\n<tr>\n  <th>Nome</th>\n  <th>Tipo</th>\n  <th>Alvo</th>\n  <th>Status</th>\n  <th>Classificação</th>\n  <th>IP resolvido</th>\n  <th>TTL</th>\n</tr>\n</thead>\n<tbody>\n${linhasServicos}\n</tbody>\n</table>\n\n<h2>Detalhamento das falhas</h2>\n\n<table>\n<thead>\n<tr>\n  <th>Serviço</th>\n  <th>Tipo</th>\n  <th>Alvo</th>\n  <th>Erro</th>\n  <th>Classificação</th>\n</tr>\n</thead>\n<tbody>\n${linhasFalhas}\n</tbody>\n</table>\n\n<footer>\n  Network Monitor | Relatório gerado automaticamente pelo n8n.\n</footer>\n\n</div>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    nome_arquivo: 'network-monitor-report.html',\n    html: html\n  }\n}];\n"
      },
